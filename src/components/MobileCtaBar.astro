---
const channels = [
  {
    label: "iMessage",
    href: "imessage://yann@yann.ca",
    className: "icon-imessage",
    svg: `<path fill="currentColor" d="M12 2C6.5 2 2 5.8 2 10.5c0 2.7 1.5 5.1 3.8 6.6L5 22l4.6-2.6c.8.2 1.6.3 2.4.3 5.5 0 10-3.8 10-8.6S17.5 2 12 2Z"/>`,
  },
  {
    label: "WhatsApp",
    href: "https://api.whatsapp.com/message/AOVXDEJODDRAJ1?autoload=1&app_absent=0",
    className: "icon-whatsapp",
    svg: `<path fill="currentColor" d="M12.1 2a9.8 9.8 0 0 0-8.5 14.7L2.5 22l5.4-1.4A9.9 9.9 0 1 0 12.1 2Zm5.8 14.1c-.2.6-1.3 1.1-1.8 1.2-.5.1-1.1.2-3.7-.8-3.1-1.2-5.1-4.4-5.2-4.6-.2-.2-1.3-1.7-1.3-3.2 0-1.5.8-2.3 1.1-2.6.2-.3.6-.4.9-.4h.6c.2 0 .5 0 .7.5.2.6.8 2 .9 2.2.1.2.1.4 0 .6-.1.2-.2.4-.4.6-.2.2-.4.4-.5.6-.2.2-.4.4-.2.7.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.5 1.5.3.1.6.1.8-.1.2-.3.9-1.1 1.2-1.5.2-.3.5-.3.8-.2.3.1 2 .9 2.3 1.1.3.2.5.3.6.4.1.2.1 1-.1 1.6Z"/>`,
  },
  {
    label: "Messenger",
    href: "https://m.me/FraserValleyiPhoneRepair",
    className: "icon-messenger",
    svg: `<path fill="currentColor" d="M12 2C6.5 2 2.2 6 2.2 11.4c0 2.9 1.2 5.4 3.3 7.1V22l3-1.6c1 .3 2.1.5 3.3.5 5.5 0 9.8-4 9.8-9.4C21.8 6 17.5 2 12 2Zm1 12.6-2.5-2.7-4.8 2.7 5.3-5.7 2.5 2.7 4.8-2.7-5.3 5.7Z"/>`,
  },
];
---

<div class="mobile-contact-bar" aria-label="Contact options">
  {channels.map((item) => (
    <a class={item.className} href={item.href} aria-label={`Contact by ${item.label}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={item.svg} />
      <span>{item.label}</span>
    </a>
  ))}
</div>
