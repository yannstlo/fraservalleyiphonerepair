---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const reviewUrl = "https://share.google/PExskCNXynymAMYbX";

const services = [
  ["Screen replacement", "Cracked glass, dead LCDs, touch issues, and front screen assemblies."],
  ["Battery replacement", "A straightforward fix when your phone is not holding a useful charge."],
  ["Charging issues", "Port problems, poor cable fit, and intermittent charging."],
  ["Diagnostics", "Tell me what happened and your iPhone model for clear next steps."],
];

const pricing = [
  ["iPhone 15", "$150"], ["iPhone 15 Pro", "$175"],
  ["iPhone 14", "$150"], ["iPhone 14 Pro", "$175"],
  ["iPhone 12 / 12 Pro", "$160"], ["iPhone SE (2nd generation)", "$100"],
  ["iPhone 11", "$150"], ["iPhone 11 Pro", "$175"], ["iPhone 11 Pro Max", "$200"],
  ["iPhone XR / iPhone X", "$120"],
];

const communities = ["Surrey", "Langley", "Pitt Meadows", "Maple Ridge", "Aldergrove", "Abbotsford", "Mission", "Chilliwack"];

const contactChannels = [
  { label: "iMessage", href: "imessage://yann@yann.ca", status: "Opens Messages", className: "icon-imessage" },
  { label: "WhatsApp", href: "https://api.whatsapp.com/message/AOVXDEJODDRAJ1?autoload=1&app_absent=0", status: "Opens WhatsApp Business", className: "icon-whatsapp" },
  { label: "Messenger", href: "https://m.me/FraserValleyiPhoneRepair", status: "Opens Facebook Messenger", className: "icon-messenger" },
];
---

<Layout title="Mission, BC" description="iPhone screen repair, battery replacement, charging diagnostics, and local repair information across the Fraser Valley.">
  <SiteHeader />

  <main>
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="eyebrow">Mission, BC / Fraser Valley</p>
        <h1>iPhone repair, handled clearly.</h1>
        <p class="hero-text">Screen assemblies, batteries, charging issues, and diagnostics for customers across the Fraser Valley. Most common repairs are completed in front of you in 30-45 minutes.</p>
        <div class="hero-details"><span>Open daily 10am-10pm</span><span>While you watch</span><span>Current prices below</span></div>
      </div>
      <div class="hero-visual">
        <img src="/images/hero-clean.png" alt="Cracked iPhone and replacement screen on a clean repair work surface" />
      </div>
    </section>

    <section class="proof-strip" aria-label="Repair highlights">
      <div><strong>30-45 min</strong><span>Typical repair time</span></div>
      <div><strong>While you watch</strong><span>Your phone stays in view</span></div>
      <div><strong>Current pricing</strong><span>Common screen repairs listed below</span></div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-heading">
      <div class="contact-copy">
        <p class="eyebrow">Start a repair</p>
        <h2 id="contact-heading">Send the model and what happened.</h2>
        <p>Use the channel that is easiest for you. iMessage, WhatsApp Business, and Messenger are available now.</p>
      </div>
      <div class="contact-actions">
        {contactChannels.map((item) => (
          <a class={`contact-button ${item.className}`} href={item.href} aria-label={`Contact Fraser Valley iPhone Repair by ${item.label}`}>
            <span>{item.label}</span>
            <small>{item.status}</small>
          </a>
        ))}
      </div>
    </section>

    <section class="section services" id="services">
      <div class="section-intro"><p class="eyebrow">Repair services</p><h2>Practical repairs, explained clearly.</h2><p>Common repairs include cracked screens, weak batteries, charging problems, and model-specific diagnostics.</p></div>
      <div class="service-grid">
        {services.map(([title, description], index) => <article class="service-card"><span>0{index + 1}</span><h3>{title}</h3><p>{description}</p></article>)}
      </div>
    </section>

    <section class="section pricing" id="pricing">
      <div class="section-intro"><p class="eyebrow">Front screen assemblies</p><h2>Current screen pricing.</h2><p>Listed prices apply to front screen assemblies and include installation. Availability for battery, charging, back-glass, and other repairs depends on the exact model and part supply.</p></div>
      <div class="price-list" role="table" aria-label="iPhone screen repair prices">
        <div class="price-head" role="row"><span role="columnheader">iPhone model</span><span role="columnheader">Screen repair</span></div>
        {pricing.map(([model, price]) => <div class="price-row" role="row"><span role="cell">{model}</span><strong role="cell">{price}</strong></div>)}
        <div class="price-footer">iPhone 16, 15 Plus / Pro Max, 14 Plus / Pro Max, 13 series, and older models are handled by current part availability.</div>
      </div>
    </section>

    <section class="text-flow">
      <div><p class="eyebrow">How it works</p><h2>Three steps. No appointment maze.</h2></div>
      <ol>
        <li><strong>01</strong><div><h3>Identify the model and issue</h3><p>Cracked screen, lines on display, no charge, or a weak battery.</p></div></li>
        <li><strong>02</strong><div><h3>Confirm availability and timing</h3><p>Parts and repair timing depend on the exact model and damage.</p></div></li>
        <li><strong>03</strong><div><h3>Bring it by for repair</h3><p>Most repairs are completed in front of you while you watch.</p></div></li>
      </ol>
    </section>

    <section class="section area" id="area">
      <div class="visit-copy"><p class="eyebrow">Service area</p><h2>Mission-based. Fraser Valley-wide.</h2><p>Serving customers from Surrey to Chilliwack, on both sides of the Fraser River.</p></div>
      <ul>{communities.map((community) => <li>{community}</li>)}</ul>
    </section>

    <section class="review-section"><p class="eyebrow">Past customer?</p><div class="review-stars" aria-label="Five star review">*****</div><h2>Review us on Google.</h2><p>Reviews make it easier for local customers to find a repair option they can trust.</p><a class="review-link" href={reviewUrl} target="_blank" rel="noreferrer">Review us on Google</a></section>
  </main>

  <SiteFooter />
</Layout>
