---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const appleIdentifyUrl = "https://support.apple.com/en-ca/108044";

const contactOptions = [
  {
    label: "iMessage",
    href: "imessage://yann@yann.ca",
    status: "Opens Messages",
    className: "icon-imessage",
  },
  {
    label: "WhatsApp",
    href: "https://api.whatsapp.com/message/AOVXDEJODDRAJ1?autoload=1&app_absent=0",
    status: "WhatsApp Business",
    className: "icon-whatsapp",
  },
  {
    label: "Messenger",
    href: "https://m.me/FraserValleyiPhoneRepair",
    status: "Facebook page inbox",
    className: "icon-messenger",
  },
];

const steps = [
  {
    number: "01",
    title: "Open Settings",
    body: "On the iPhone, open Settings. If the screen is too damaged, send a photo of the back or the SIM tray area instead.",
  },
  {
    number: "02",
    title: "Go to General, then About",
    body: "The About screen shows the device name, software version, serial number, and model information.",
  },
  {
    number: "03",
    title: "Tap Model Number",
    body: "Tap the part-number style code until it switches to an A-number, such as A2482 or A2649.",
  },
];

const checklist = [
  "The A-number if you can find it",
  "What happened: cracked screen, battery, charging, liquid, no power",
  "A clear photo if the damage is visible",
  "Whether Face ID, touch, or charging still works",
];
---

<Layout
  title="Identify your iPhone model"
  description="Find your iPhone model number (A####) so we can quote you quickly."
>
  <SiteHeader />

  <main>
    <section class="identify-hero">
      <div class="identify-hero-copy">
        <p class="eyebrow">Identify your iPhone</p>
        <h1>Find the exact model before repair.</h1>
        <p>
          The model number is the fastest way to confirm parts, pricing, and repair timing. It usually looks like
          <strong> A####</strong>.
        </p>
      </div>

      <aside class="identify-note" aria-label="What to send">
        <span>Send this</span>
        <strong>A#### model number</strong>
        <p>Plus the issue and a photo if it helps.</p>
      </aside>
    </section>

    <section class="section identify-steps">
      <div class="section-intro">
        <p class="eyebrow">Settings path</p>
        <h2>How to find the A-number.</h2>
        <p>If you first see something like <strong>MQ...</strong>, tap it once. It usually switches to the hardware model number.</p>
      </div>

      <div class="identify-step-grid">
        {steps.map((step) => (
          <article class="identify-step-card">
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section identify-send section-alt">
      <div class="identify-send-copy">
        <p class="eyebrow">Message checklist</p>
        <h2>Send enough detail for a useful reply.</h2>
        <ul>
          {checklist.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="contact-actions compact-actions">
        {contactOptions.map((option) => (
          <a class={`contact-button ${option.className}`} href={option.href} aria-label={`Contact by ${option.label}`}>
            <span>{option.label}</span>
            <small>{option.status}</small>
          </a>
        ))}
      </div>
    </section>

    <section class="section identify-reference">
      <div class="section-intro">
        <p class="eyebrow">Apple reference</p>
        <h2>Still not sure?</h2>
        <p>Apple keeps a current list of iPhone model numbers by region.</p>
        <a class="link" href={appleIdentifyUrl} target="_blank" rel="noreferrer">
          Open Apple Support model list
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
