---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const appleIdentifyUrl = "https://support.apple.com/en-ca/108044";

const contactOptions = [
  {
    label: "iMessage",
    href: "imessage://yann@yann.ca",
    status: "Opens Messages",
    className: "icon-imessage",
  },
  {
    label: "WhatsApp",
    href: "https://api.whatsapp.com/message/AOVXDEJODDRAJ1?autoload=1&app_absent=0",
    status: "WhatsApp Business",
    className: "icon-whatsapp",
  },
  {
    label: "Messenger",
    href: "https://m.me/FraserValleyiPhoneRepair",
    status: "Facebook page inbox",
    className: "icon-messenger",
  },
];
---

<Layout
  title="Identify your iPhone model"
  description="Find your iPhone model number (A####) so we can quote you quickly."
>
  <SiteHeader />

  <main>
    <section class="section text-flow">
      <div class="section-intro">
        <p class="eyebrow">Identify your iPhone</p>
        <h1>Find the model number before repair.</h1>
        <p>
          The fastest way to get accurate options is to send the model number, usually shown as
          <strong> A####</strong>, along with what happened to the phone.
        </p>
      </div>

      <h2>How to find your model number</h2>
      <ol>
        <li>Open <strong>Settings</strong>.</li>
        <li>Tap <strong>General</strong>, then <strong>About</strong>.</li>
        <li>Tap <strong>Model Number</strong> until it shows an <strong>A####</strong> number.</li>
      </ol>
      <p>
        If you see something like <strong>MQ...</strong>, tapping it usually switches to the hardware model number.
      </p>

      <div class="contact-actions compact-actions">
        {contactOptions.map((option) => (
          <a class={`contact-button ${option.className}`} href={option.href} aria-label={`Contact by ${option.label}`}>
            <span>{option.label}</span>
            <small>{option.status}</small>
          </a>
        ))}
      </div>
    </section>

    <section class="section text-flow section-alt">
      <div class="section-intro">
        <p class="eyebrow">Apple reference</p>
        <h2>Not sure which iPhone you have?</h2>
        <p>
          Apple keeps a current list of iPhone model numbers by region. Use it when the model number is unclear or
          the phone is too damaged to navigate normally.
        </p>
        <p>
          <a class="link" href={appleIdentifyUrl} target="_blank" rel="noreferrer">
            Identify your iPhone model on Apple Support
          </a>
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
