---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import fs from "node:fs/promises";
import path from "node:path";

const museumDir = path.join(process.cwd(), "public", "images", "museum");

function titleFromFilename(filename) {
  return filename
    .replace(/\.[^.]+$/, "")
    .replace(/\(\d+\)$/, "")
    .replace(/[-_]+/g, " ")
    .trim();
}

const files = (await fs.readdir(museumDir)).filter((f) => f.toLowerCase() !== "readme.md");
files.sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }));

const images = files.map((file) => ({
  src: `/images/museum/${file}`,
  alt: titleFromFilename(file),
}));
---

<Layout
  title="Archives"
  description="A few of the more spectacular iPhone disasters (and saves) we've seen in the Fraser Valley."
>
  <SiteHeader />

  <main>
    <section class="section museum-page">
      <div class="section-intro">
        <p class="eyebrow">Repair archive</p>
        <h1>Archives</h1>
        <p>Some of the more spectacular iPhone disasters and saves over the years.</p>
      </div>

      {images.length === 0 ? (
        <div class="empty-state">
          No archive images yet.
        </div>
      ) : (
        <div class="museum-grid">
          {images.map((img) => (
            <figure>
              <img src={img.src} alt={img.alt} loading="lazy" />
            </figure>
          ))}
        </div>
      )}
    </section>
  </main>

  <SiteFooter />
</Layout>
