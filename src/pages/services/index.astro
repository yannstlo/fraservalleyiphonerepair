---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const pricing = [
  ["iPhone 15", "$150"], ["iPhone 15 Pro", "$175"],
  ["iPhone 14", "$150"], ["iPhone 14 Pro", "$175"],
  ["iPhone 12 / 12 Pro", "$160"], ["iPhone SE (2nd generation)", "$100"],
  ["iPhone 11", "$150"], ["iPhone 11 Pro", "$175"], ["iPhone 11 Pro Max", "$200"],
  ["iPhone XR / iPhone X", "$120"],
];

const services = [
  ["Screen replacement", "Cracked glass, dead displays, touch problems, black spots, colored lines, and LCD damage."],
  ["Battery replacement", "Model-specific replacement for weak battery life, sudden shutdowns, and poor charge retention."],
  ["Charging diagnostics", "Checks for cable fit, debris, port wear, battery condition, and board-level charging behavior."],
  ["Device diagnostics", "Useful for no power, liquid exposure, restart loops, intermittent faults, and unclear damage."],
];
---

<Layout title="Services and Pricing" description="iPhone screen repair pricing, battery replacement notes, charging diagnostics, and current service information for Fraser Valley iPhone Repair.">
  <SiteHeader />

  <main>
    <section class="section services">
      <div class="section-intro">
        <p class="eyebrow">Repair services</p>
        <h1>iPhone repair services and pricing.</h1>
        <p>Common repairs include cracked screens, weak batteries, charging problems, and model-specific diagnostics. Send your model and what happened through iMessage, WhatsApp Business, or Messenger for current availability.</p>
      </div>
      <div class="service-grid">
        {services.map(([title, description], index) => <article class="service-card"><span>0{index + 1}</span><h3>{title}</h3><p>{description}</p></article>)}
      </div>
    </section>

    <section class="section pricing">
      <div class="section-intro">
        <p class="eyebrow">Front screen assemblies</p>
        <h2>Common screen pricing.</h2>
        <p>Listed prices include installation. Battery, charging, back-glass, older model, and less common repairs depend on exact model and part supply.</p>
      </div>
      <div class="price-list" role="table" aria-label="Common iPhone screen repair prices">
        <div class="price-head" role="row"><span role="columnheader">iPhone model</span><span role="columnheader">Screen repair</span></div>
        {pricing.map(([model, price]) => <div class="price-row" role="row"><span role="cell">{model}</span><strong role="cell">{price}</strong></div>)}
        <div class="price-footer">iPhone 16, 15 Plus / Pro Max, 14 Plus / Pro Max, 13 series, and older models are handled by current part availability.</div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
