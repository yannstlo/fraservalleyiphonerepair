---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { messengerUrl } from "../lib/site";
---

<Layout title="Contact" description="Request an iPhone repair appointment in Mission, BC. Exact directions are shared after confirmation." >
  <SiteHeader />

  <main class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <section class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-white/10 dark:bg-white/5">
        <h2 class="text-lg font-semibold">Request an appointment</h2>
        <p class="mt-2 text-zinc-600 dark:text-zinc-300">
          Message your iPhone model and the issue (cracked screen, lines, no charge, etc.). Photos help.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a class="rounded-md bg-emerald-500 px-4 py-3 font-semibold text-zinc-950 hover:bg-emerald-400" href={messengerUrl} target="_blank" rel="noreferrer">Message on Messenger</a>
        </div>
      </section>

      <section class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-white/10 dark:bg-white/5">
        <h2 class="text-lg font-semibold">Location & visits</h2>
        <div class="mt-3 text-zinc-600 dark:text-zinc-300">
          <div><span class="text-zinc-500 dark:text-zinc-400">Area:</span> Mission, BC</div>
          <div class="mt-2"><span class="text-zinc-500 dark:text-zinc-400">Visits:</span> By confirmed appointment only</div>
          <p class="mt-3">For privacy and security, the exact address and directions are sent after your appointment is confirmed.</p>
        </div>

      </section>
    </div>

    <section class="mt-10 rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-white/10 dark:bg-white/5">
      <h2 class="text-lg font-semibold">Service area</h2>
      <p class="mt-2 text-zinc-600 dark:text-zinc-300">
        Fraser Valley from Surrey to Chilliwack (both sides of the Fraser River), including Abbotsford, Aldergrove,
        Chilliwack, Langley, Maple Ridge, Mission, and Pitt Meadows.
      </p>
    </section>
  </main>

  <SiteFooter />
</Layout>
