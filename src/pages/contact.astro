---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const contactChannels = [
  { label: "iMessage", href: "imessage://yann@yann.ca", status: "Opens Messages", className: "icon-imessage" },
  { label: "WhatsApp", href: "https://api.whatsapp.com/message/AOVXDEJODDRAJ1?autoload=1&app_absent=0", status: "Opens WhatsApp Business", className: "icon-whatsapp" },
  { label: "Messenger", href: "https://m.me/FraserValleyiPhoneRepair", status: "Opens Facebook Messenger", className: "icon-messenger" },
];

const communities = ["Surrey", "Langley", "Pitt Meadows", "Maple Ridge", "Aldergrove", "Abbotsford", "Mission", "Chilliwack"];
---

<Layout title="Contact" description="Contact Fraser Valley iPhone Repair through iMessage, WhatsApp Business, or Messenger. Mission-based service for the Fraser Valley.">
  <SiteHeader />

  <main>
    <section class="contact-section">
      <div class="contact-copy">
        <p class="eyebrow">Start a repair</p>
        <h1>Send the model and what happened.</h1>
        <p>Use iMessage, WhatsApp Business, or Messenger. Include the iPhone model, the issue, and a photo if it helps.</p>
      </div>
      <div class="contact-actions">
        {contactChannels.map((item) => (
          <a class={`contact-button ${item.className}`} href={item.href} aria-label={`Contact Fraser Valley iPhone Repair by ${item.label}`}>
            <span>{item.label}</span>
            <small>{item.status}</small>
          </a>
        ))}
      </div>
    </section>

    <section class="section area">
      <div class="visit-copy">
        <p class="eyebrow">Service area</p>
        <h2>Mission-based. Fraser Valley-wide.</h2>
        <p>Serving customers from Surrey to Chilliwack, on both sides of the Fraser River.</p>
      </div>
      <ul>{communities.map((community) => <li>{community}</li>)}</ul>
    </section>
  </main>

  <SiteFooter />
</Layout>
